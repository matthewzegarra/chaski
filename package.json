{
  "name": "chaski",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:cliente": "pnpm --filter @chaski/cliente dev",
    "dev:consola": "pnpm --filter @chaski/consola dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
