# =============================================================================
# CHASKI · environment variables
# Copy to .env (`cp .env.example .env`). .env is git-ignored.
# The values below are LOCAL-ONLY placeholders. In Azure every secret is a
# Key Vault reference in Container Apps, read with Managed Identity.
# =============================================================================

# ---- General ---------------------------------------------------------------
# DEV | TEST | PROD (shown in the console header). AUTH_MODE=dev is refused in PROD.
CHASKI_ENV=DEV
LOG_LEVEL=INFO
# Origins allowed by CORS (the two web apps).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Requests per minute per IP (in-memory rate limit; 0 disables it).
RATE_LIMIT_PER_MINUTE=300
# Enables /api/v1/demo/* (also requires the Admin role).
DEMO_MODE=true

# ---- Local Postgres (docker compose) ---------------------------------------
# Owner/admin account: runs migrations and the simulator only.
POSTGRES_PASSWORD=local-only-admin-change-me
# Service account used by the APIs (read/write core+ops, read gold).
CHASKI_APP_DB_PASSWORD=local-only-app-change-me
# Read-only account used by NL2SQL (SELECT on 3 gold views, 10 s timeout).
CHASKI_READONLY_DB_PASSWORD=local-only-readonly-change-me
# In Azure, set these directly instead (Key Vault references):
#   DATABASE_URL=postgresql+psycopg://<user>:<pwd>@<server>.postgres.database.azure.com:5432/chaski?sslmode=require
#   MIGRATIONS_DATABASE_URL=...
# Analytics DB. Locally the gold schema of the same Postgres. In Azure: Azure SQL.
#   ANALYTICS_DB_URL=mssql+pyodbc://<user>:<pwd>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server
#   ANALYTICS_DIALECT=tsql
ANALYTICS_DIALECT=postgres

# ---- Authentication --------------------------------------------------------
# dev   = local user/role selector, HS256 tokens issued by core-api /api/v1/dev/token
# entra = Entra ID tokens (RS256 via JWKS) with App Roles
AUTH_MODE=dev
# >= 32 chars. Local only; never used when AUTH_MODE=entra.
DEV_JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
ENTRA_TENANT_ID=
# API app registration audience, e.g. api://chaski-api
ENTRA_AUDIENCE=
# Optional comma-separated issuer override (defaults to the tenant v1+v2 issuers).
ENTRA_ISSUERS=
# SPA app registration used by MSAL in the web apps.
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=

# ---- AI (ia-api) -----------------------------------------------------------
# mock = deterministic local providers; azure = Azure OpenAI + Content Safety + Document Intelligence
AI_MODE=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=

# ---- Integrations ----------------------------------------------------------
# Fabric Eventstream (Event Hubs-compatible). Empty = do not publish.
EVENTSTREAM_CONNECTION_STRING=
EVENTSTREAM_NAME=
# HMAC secret shared with Fabric Activator for POST /api/v1/fraud/webhook.
FRAUD_WEBHOOK_SECRET=local-only-webhook-secret-change-me
# Key Vault whose secret METADATA is listed in the console (never values).
KEY_VAULT_URL=
# Blob Storage for KYC images. Empty = local volume.
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=kyc
# Container Apps Job that runs the data pipeline (started via ARM with Managed Identity).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
PIPELINE_JOB_NAME=
# GitHub Actions runs shown in the DevOps module (read-only fine-grained token).
GITHUB_REPO=
GITHUB_TOKEN=
# ApisPeru DNI lookup (https://dniruc.apisperu.com). Empty = deterministic mock.
# In Azure: Key Vault secret dni-lookup-token + ENABLE_DNI_LOOKUP=true. Never commit the token.
DNI_LOOKUP_MODE=auto
DNI_LOOKUP_TOKEN=
DNI_LOOKUP_BASE_URL=https://dniruc.apisperu.com/api/v1

# ---- Observability ---------------------------------------------------------
# Empty = OpenTelemetry disabled.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Web apps (runtime config injected into env.js by nginx) ---------------
CHASKI_CUENTAS_API_URL=http://localhost:8001
CHASKI_CORE_API_URL=http://localhost:8002
CHASKI_IA_API_URL=http://localhost:8003
CHASKI_POWERBI_EMBED_URL=
